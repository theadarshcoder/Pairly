PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pairly
MONGO_DB_NAME=pairly

# Auth
JWT_SECRET=change_me_in_production_use_at_least_32_chars
JWT_EXPIRES_IN=7d

# AI (stub for now — Claude API)
ANTHROPIC_API_KEY=sk-ant-placeholder

# CORS — comma-separated list of allowed origins
FRONTEND_URL=http://localhost:5173

# Socket rate limiting
SOCKET_RATE_LIMIT_EVENTS=50
SOCKET_RATE_LIMIT_WINDOW_MS=10000

# Buffer flush interval (milliseconds) — 100ms = 10 FPS
FLUSH_INTERVAL_MS=100
